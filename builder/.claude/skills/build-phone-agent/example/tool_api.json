{
 "openapi": "3.0.3",
 "info": {
  "title": "Lumen Energy tools (invented example)",
  "version": "1"
 },
 "servers": [
  {
   "url": "https://api.example.test/lumen"
  }
 ],
 "paths": {
  "/verify_identity": {
   "post": {
    "summary": "Check one answer. Two wrong answers end the check.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "client_ref": {
          "type": "string"
         },
         "question": {
          "type": "string",
          "enum": [
           "postcode",
           "birth_year"
          ]
         },
         "reply": {
          "type": "string",
          "description": "postcode as said, birth_year as four digits"
         }
        },
        "required": [
         "client_ref",
         "question",
         "reply"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "correct": {
           "type": "boolean"
          },
          "tries_left": {
           "type": "integer"
          },
          "passed": {
           "type": "boolean"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/get_account": {
   "post": {
    "summary": "The overdue items. Refused until the check passed.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "client_ref": {
          "type": "string"
         }
        },
        "required": [
         "client_ref"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "items": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "item_id": {
              "type": "string"
             },
             "kind": {
              "type": "string",
              "enum": [
               "electricity",
               "gas"
              ]
             },
             "overdue": {
              "type": "number"
             },
             "days_overdue": {
              "type": "integer"
             },
             "smallest_payment": {
              "type": "number"
             }
            }
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/create_promise": {
   "post": {
    "summary": "Record one promise per item.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "client_ref": {
          "type": "string"
         },
         "item_id": {
          "type": "string"
         },
         "sum": {
          "type": "number"
         },
         "pay_on": {
          "type": "string",
          "format": "date"
         }
        },
        "required": [
         "client_ref",
         "item_id",
         "sum",
         "pay_on"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "promise_ref": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/add_note": {
   "post": {
    "summary": "Not used by this brief.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "client_ref": {
          "type": "string"
         },
         "item_id": {
          "type": "string"
         },
         "why": {
          "type": "string",
          "enum": [
           "said_no"
          ]
         }
        },
        "required": [
         "client_ref",
         "item_id",
         "why"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/schedule_callback": {
   "post": {
    "summary": "Book a callback.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "client_ref": {
          "type": "string"
         },
         "day": {
          "type": "string",
          "format": "date"
         },
         "at": {
          "type": "string",
          "description": "HH:MM"
         }
        },
        "required": [
         "client_ref",
         "day",
         "at"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/transfer_to_agent": {
   "post": {
    "summary": "Hand the call to a person.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "client_ref": {
          "type": "string"
         },
         "team": {
          "type": "string",
          "enum": [
           "desk"
          ]
         }
        },
        "required": [
         "client_ref",
         "team"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/close_call": {
   "post": {
    "summary": "End the call. Always the last tool call.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "client_ref": {
          "type": "string"
         },
         "result": {
          "type": "string",
          "enum": [
           "agreed",
           "declined",
           "handed_over",
           "unverified",
           "absent"
          ]
         },
         "code": {
          "type": "string",
          "description": "See the brief."
         }
        },
        "required": [
         "client_ref",
         "result"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}